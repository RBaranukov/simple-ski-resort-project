<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="changelog-v1.5" author="RBaranukov">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user"/>

                <columnExists tableName="user" columnName="id"/>
                <columnExists tableName="user" columnName="username"/>
                <columnExists tableName="user" columnName="password"/>
                <columnExists tableName="user" columnName="active"/>
                <columnExists tableName="user" columnName="role"/>
            </not>
        </preConditions>

        <createTable tableName="user">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>

            <column name="username" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="password" type="varchar(100)">
                <constraints nullable="false"/>
            </column>

            <column defaultValue="false" name="active" type="boolean">
            </column>

            <column defaultValue="ROLE_MANAGER" name="role" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>