<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create_tables_coaches_ski-passes_v1.0" author="RBaranukov">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ski_pass"/>
                <tableExists tableName="coach"/>

                <columnExists tableName="ski_pass" columnName="id" />
                <columnExists tableName="ski_pass" columnName="date"/>
                <columnExists tableName="ski_pass" columnName="cost"/>

                <columnExists tableName="coach" columnName="id"/>
                <columnExists tableName="coach" columnName="name"/>
                <columnExists tableName="coach" columnName="surname"/>
                <columnExists tableName="coach" columnName="category"/>
                <columnExists tableName="coach" columnName="birth_date"/>
                <columnExists tableName="coach" columnName="sex"/>
                <columnExists tableName="coach" columnName="photo"/>
                <columnExists tableName="coach" columnName="ski_pass_id"/>
                <columnExists tableName="coach" columnName="guest_id"/>
            </not>
        </preConditions>

        <createTable tableName="ski_pass">
            <column autoIncrement="true" name="id"  type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>

            <column name="duration" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column defaultValue="1000" name="cost" type="decimal">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="coach">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>

            <column name="name" type="varchar(30)">
                <constraints nullable="false"/>
            </column>

            <column name="surname" type="varchar(30)">
                <constraints nullable="false"/>
            </column>

            <column name="category" type="varchar(30)">
                <constraints nullable="false"/>
            </column>

            <column name="birth_date" type="date">
                <constraints nullable="false"/>
            </column>

            <column defaultValue="unknown" name="sex" type="char">
                <constraints nullable="false"/>
            </column>

            <column name="photo" type="longblob">
                <constraints nullable="true"/>
            </column>

            <column defaultValue="null" name="ski_pass_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>